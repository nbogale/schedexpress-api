generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique @db.VarChar(255)
  passwordHash            String                  @map("password_hash") @db.VarChar(255)
  firstName               String                  @map("first_name") @db.VarChar(100)
  lastName                String                  @map("last_name") @db.VarChar(100)
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  username                String                  @unique @db.VarChar(50)
  status                  UserStatus              @default(ACTIVE)
  role                    UserRole
  auditLogs               AuditLog[]
  notifications           Notification[]
  performedActions        ScheduleChangeAction[]  @relation("ActionPerformer")
  reviewedRequests        ScheduleChangeRequest[] @relation("RequestReviewer")
  student                 Student?
  teacher                 Teacher?
  userAccount             UserAccount?
  accountActionsPerformed UserAccountHistory[]    @relation("AccountActionPerformer")
  statusChangesPerformed  UserStatusHistory[]     @relation("StatusChangePerformer")
  statusHistory           UserStatusHistory[]
  
  // Academic Cycle relations
  academicCycleConfigs    AcademicCycleConfig[]   @relation("AcademicCycleConfigCreator")
  academicCycleValidators AcademicCycle[]         @relation("AcademicCycleValidator")
  
  // Grade relations
  gradesGiven            StudentGrade[]           @relation("GradeTeacher")

  @@map("user")
}

model UserStatusHistory {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  status        UserStatus
  reason        String?    @db.VarChar(500)
  changedBy     String     @map("changed_by")
  changedAt     DateTime   @default(now()) @map("changed_at")
  changedByUser User       @relation("StatusChangePerformer", fields: [changedBy], references: [id])
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedAt])
  @@map("user_status_history")
}

model Student {
  id                String                  @id @default(cuid())
  userId            String                  @unique @map("user_id")
  studentId         String                  @unique @map("student_id") @db.VarChar(20)
  gradeLevelId      String                  @map("grade_level_id")
  graduationYear    Int?                    @map("graduation_year")
  hasIep            Boolean                 @default(false) @map("has_iep")
  isDualEnrollment  Boolean                 @default(false) @map("is_dual_enrollment")
  isCollegeBound    Boolean                 @default(false) @map("is_college_bound")
  isCreditRecovery  Boolean                 @default(false) @map("is_credit_recovery")
  maxCreditsPerTerm Decimal                 @default(8.0) @map("max_credits_per_term") @db.Decimal(3, 1)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  waitlist          CourseWaitlist[]
  notifications     Notification[]
  schedule          Schedule?
  changeRequests    ScheduleChangeRequest[]
  gradeLevel        GradeLevel              @relation(fields: [gradeLevelId], references: [id])
  user              User                    @relation(fields: [userId], references: [id])
  courseHistory     StudentCourseHistory[]
  grades            StudentGrade[]

  @@map("student")
}

model StudentCourseHistory {
  id           String     @id @default(cuid())
  studentId    String     @map("student_id")
  courseId     String     @map("course_id")
  schoolYearId String     @map("school_year_id")
  termId       String     @map("term_id")
  grade        String?    @db.VarChar(2)
  isPassed     Boolean    @default(true) @map("is_passed")
  creditEarned Decimal    @map("credit_earned") @db.Decimal(3, 1)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  course       Course     @relation(fields: [courseId], references: [id])
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])
  term         Term       @relation(fields: [termId], references: [id])

  @@map("student_course_history")
}

model StudentGrade {
  id                String          @id @default(cuid())
  studentId         String          @map("student_id")
  courseId          String          @map("course_id")
  academicCycleId   String          @map("academic_cycle_id")
  schoolYearId      String          @map("school_year_id")
  
  // Grade data
  grade             String?         @db.VarChar(2)
  gradePoints       Decimal?        @map("grade_points") @db.Decimal(3, 2)
  percentage        Decimal?        @db.Decimal(5, 2)
  isPassed          Boolean         @default(true) @map("is_passed")
  creditEarned      Decimal         @map("credit_earned") @db.Decimal(3, 1)
  
  // Metadata
  gradedBy          String?         @map("graded_by")
  gradedAt          DateTime?       @map("graded_at")
  notes             String?         @db.Text
  
  // Relations
  student           Student         @relation(fields: [studentId], references: [id])
  course            Course          @relation(fields: [courseId], references: [id])
  academicCycle     AcademicCycle   @relation(fields: [academicCycleId], references: [id])
  schoolYear        AcademicCycle   @relation("SchoolYearGrades", fields: [schoolYearId], references: [id])
  teacher           User?           @relation("GradeTeacher", fields: [gradedBy], references: [id])
  
  @@unique([studentId, courseId, academicCycleId])
  @@map("student_grade")
}

model CourseSection {
  id                        String                  @id @default(cuid())
  courseId                  String                  @map("course_id")
  sectionNumber             String                  @map("section_number") @db.VarChar(10)
  academicCycleId           String                  @map("academic_cycle_id")
  timeBlockId               String                  @map("time_block_id")
  roomId                    String                  @map("room_id")
  teacherId                 String                  @map("teacher_id")
  maxEnrollment             Int                     @map("max_enrollment")
  currentEnrollment         Int                     @default(0) @map("current_enrollment")
  isActive                  Boolean                 @default(true) @map("is_active")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  rotationDay               RotationDay?            @map("rotation_day")
  conflicts1                CourseConflict[]        @relation("ConflictSection1")
  conflicts2                CourseConflict[]        @relation("ConflictSection2")
  course                    Course                  @relation(fields: [courseId], references: [id])
  room                      Room                    @relation(fields: [roomId], references: [id])
  academicCycle             AcademicCycle           @relation(fields: [academicCycleId], references: [id])
  teacher                   Teacher                 @relation(fields: [teacherId], references: [id])
  timeBlock                 TimeBlock               @relation(fields: [timeBlockId], references: [id])
  waitlist                  CourseWaitlist[]
  addedInActions            ScheduleChangeAction[]  @relation("AddedSection")
  removedInActions          ScheduleChangeAction[]  @relation("RemovedSection")
  currentChangeRequests     ScheduleChangeRequest[] @relation("CurrentSection")
  requestedInChangeRequests ScheduleChangeRequest[] @relation("RequestedSection")
  scheduleCourseSections    ScheduleCourseSection[]

  @@index([courseId])
  @@index([academicCycleId])
  @@index([teacherId])
  @@map("course_section")
}

model Schedule {
  id                     String                  @id @default(cuid())
  studentId              String                  @unique @map("student_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  schoolYearId           String                  @map("school_year_id")
  termId                 String                  @map("term_id")
  schoolYear             SchoolYear              @relation(fields: [schoolYearId], references: [id])
  student                Student                 @relation(fields: [studentId], references: [id])
  term                   Term                    @relation(fields: [termId], references: [id])
  scheduleCourseSections ScheduleCourseSection[]

  @@index([schoolYearId])
  @@index([termId])
  @@map("schedule")
}

model ScheduleCourseSection {
  id              String        @id @default(cuid())
  scheduleId      String        @map("schedule_id")
  courseSectionId String        @map("course_section_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  schedule        Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, courseSectionId])
  @@index([scheduleId])
  @@index([courseSectionId])
  @@map("schedule_course_section")
}

model Notification {
  id        String           @id @default(cuid())
  studentId String?          @map("student_id")
  userId    String?          @map("user_id")
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  type      NotificationType
  student   Student?         @relation(fields: [studentId], references: [id])
  user      User?            @relation(fields: [userId], references: [id])

  @@map("notification")
}

model Settings {
  id             String   @id @default(cuid())
  schoolName     String   @map("school_name")
  academicYear   String   @map("academic_year")
  semester       String
  maxCourseLoad  Int      @default(8) @map("max_course_load")
  allowConflicts Boolean  @default(false) @map("allow_conflicts")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AcademicCycleConfig {
  id                    String    @id @default(cuid())
  name                  String    @db.VarChar(100)
  description           String?   @db.Text
  isActive              Boolean   @default(false) @map("is_active")
  isDefault             Boolean   @default(false) @map("is_default")
  
  // Structure configuration
  hasSemesters          Boolean   @default(true) @map("has_semesters")
  hasQuarters           Boolean   @default(true) @map("has_quarters")
  hasTrimesters         Boolean   @default(false) @map("has_trimesters")
  hasSessions           Boolean   @default(false) @map("has_sessions")
  
  // Validation rules
  enforceStructure      Boolean   @default(true) @map("enforce_structure")
  allowCustomCycles     Boolean   @default(false) @map("allow_custom_cycles")
  requireValidation     Boolean   @default(true) @map("require_validation")
  
  // Metadata
  createdBy             String    @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  
  // Relations
  creator               User      @relation("AcademicCycleConfigCreator", fields: [createdBy], references: [id])
  cycleRules            AcademicCycleRule[]
  academicCycles        AcademicCycle[]
  
  @@map("academic_cycle_config")
}

model AcademicCycleRule {
  id                    String    @id @default(cuid())
  configId              String    @map("config_id")
  parentCycleType       CycleType? @map("parent_cycle_type")
  cycleType             CycleType @map("cycle_type")
  cycleName             String    @db.VarChar(100)
  cycleNumber           Int?      @map("cycle_number")
  isRequired            Boolean   @default(true) @map("is_required")
  minCount              Int       @default(1) @map("min_count")
  maxCount              Int       @default(1) @map("max_count")
  defaultDuration       Int       @default(90) @map("default_duration")
  sortOrder             Int       @default(0) @map("sort_order")
  
  // Validation rules
  mustBeSequential      Boolean   @default(true) @map("must_be_sequential")
  mustHaveGaps          Boolean   @default(false) @map("must_have_gaps")
  allowOverlap          Boolean   @default(false) @map("allow_overlap")
  
  // Relations
  config                AcademicCycleConfig @relation(fields: [configId], references: [id])
  
  @@unique([configId, cycleType, cycleNumber])
  @@map("academic_cycle_rule")
}

model AcademicCycle {
  id              String          @id @default(cuid())
  parentId        String?         @map("parent_id")
  configId        String?         @map("config_id")
  name            String          @db.VarChar(100)
  cycleType       CycleType       @map("cycle_type")
  cycleNumber     Int?            @map("cycle_number")
  startDate       DateTime @db.Date @map("start_date")
  endDate         DateTime @db.Date @map("end_date")
  isCurrent       Boolean         @default(false) @map("is_current")
  isActive        Boolean         @default(true) @map("is_active")
  
  // Validation status
  isValidated     Boolean         @default(false) @map("is_validated")
  validatedBy     String?         @map("validated_by")
  validatedAt     DateTime?       @map("validated_at")
  validationNotes String?         @map("validation_notes") @db.Text
  
  // Metadata
  description     String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  
  // Self-referencing relations
  parent          AcademicCycle?  @relation("CycleHierarchy", fields: [parentId], references: [id])
  children        AcademicCycle[] @relation("CycleHierarchy")
  
  // Configuration relations
  config          AcademicCycleConfig? @relation(fields: [configId], references: [id])
  validator       User?           @relation("AcademicCycleValidator", fields: [validatedBy], references: [id])
  
  // Related data
  grades          StudentGrade[]
  schoolYearGrades StudentGrade[] @relation("SchoolYearGrades")
  courseSections  CourseSection[]
  
  @@index([parentId])
  @@index([cycleType])
  @@index([configId])
  @@map("academic_cycle")
}

model SchoolYear {
  id             String                  @id @default(cuid())
  name           String                  @db.VarChar(50)
  startDate      DateTime                @map("start_date")
  endDate        DateTime                @map("end_date")
  isCurrent      Boolean                 @default(false) @map("is_current")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  schedules      Schedule[]
  changeRequests ScheduleChangeRequest[]
  courseHistory  StudentCourseHistory[]
  terms          Term[]

  @@map("school_year")
}

model Term {
  id             String                  @id @default(cuid())
  schoolYearId   String                  @map("school_year_id")
  name           String                  @db.VarChar(50)
  startDate      DateTime                @map("start_date")
  endDate        DateTime                @map("end_date")
  isCurrent      Boolean                 @default(false) @map("is_current")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  schedules      Schedule[]
  changeRequests ScheduleChangeRequest[]
  courseHistory  StudentCourseHistory[]
  schoolYear     SchoolYear              @relation(fields: [schoolYearId], references: [id])

  @@map("term")
}

model Department {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  code        String           @unique @db.VarChar(10)
  description String?
  courses     Course[]
  sequences   CourseSequence[]
  teachers    Teacher[]

  @@map("department")
}

model CourseLevel {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  rank      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  courses   Course[]

  @@map("course_level")
}

model GradeLevel {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(50)
  level     Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  courses   Course[]  @relation("MinGradeLevel")
  students  Student[]

  @@map("grade_level")
}

model Course {
  id               String                 @id @default(cuid())
  code             String                 @unique @db.VarChar(20)
  name             String                 @db.VarChar(255)
  description      String?
  departmentId     String                 @map("department_id")
  credits          Decimal                @default(1.0) @db.Decimal(3, 1)
  courseLevelId    String                 @map("course_level_id")
  minGradeLevelId  String                 @map("min_grade_level_id")
  maxStudents      Int                    @default(30) @map("max_students")
  isElective       Boolean                @default(false) @map("is_elective")
  isCore           Boolean                @default(false) @map("is_core")
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  courseLevel      CourseLevel            @relation(fields: [courseLevelId], references: [id])
  department       Department             @relation(fields: [departmentId], references: [id])
  minGradeLevel    GradeLevel             @relation("MinGradeLevel", fields: [minGradeLevelId], references: [id])
  prerequisites    CoursePrerequisite[]   @relation("PrerequisiteCourses")
  prerequisiteFor  CoursePrerequisite[]   @relation("RequiredCourses")
  conflictingRules CourseRule[]           @relation("ConflictingCourseRules")
  courseRules      CourseRule[]           @relation("CourseRules")
  sections         CourseSection[]
  sequences        CourseSequence[]
  courseHistory    StudentCourseHistory[]
  grades           StudentGrade[]

  @@map("course")
}

model CoursePrerequisite {
  id                   String   @id @default(cuid())
  courseId             String   @map("course_id")
  prerequisiteCourseId String   @map("prerequisite_course_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  course               Course   @relation("PrerequisiteCourses", fields: [courseId], references: [id])
  prerequisiteCourse   Course   @relation("RequiredCourses", fields: [prerequisiteCourseId], references: [id])

  @@unique([courseId, prerequisiteCourseId])
  @@map("course_prerequisite")
}

model CourseSequence {
  id            String     @id @default(cuid())
  departmentId  String     @map("department_id")
  courseId      String     @map("course_id")
  sequenceOrder Int        @map("sequence_order")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  course        Course     @relation(fields: [courseId], references: [id])
  department    Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, courseId])
  @@map("course_sequence")
}

model Room {
  id        String          @id @default(cuid())
  name      String          @db.VarChar(50)
  capacity  Int
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  sections  CourseSection[]

  @@map("room")
}

model TimeBlock {
  id                  String                  @id @default(cuid())
  name                String                  @db.VarChar(50)
  startTime           DateTime                @db.Time @map("start_time") // Stores time in HH:MM format (e.g., "09:30 AM", "02:45 PM")
  endTime             DateTime                @db.Time @map("end_time")   // Stores time in HH:MM format (e.g., "10:45 AM", "04:00 PM")
  isActive            Boolean                 @default(true) @map("is_active")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  sections            CourseSection[]
  preferredInRequests ScheduleChangeRequest[]

  @@map("time_block")
}

model Teacher {
  id           String          @id @default(cuid())
  name         String?
  email        String          @unique
  password     String?
  departmentId String          @map("department_id")
  maxCourses   Int             @default(6) @map("max_courses")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  userId       String          @unique @map("user_id")
  sections     CourseSection[]
  department   Department      @relation(fields: [departmentId], references: [id])
  user         User            @relation(fields: [userId], references: [id])

  @@map("teacher")
}

model ScheduleChangeRequest {
  id                       String                 @id @default(cuid())
  studentId                String                 @map("student_id")
  schoolYearId             String                 @map("school_year_id")
  termId                   String                 @map("term_id")
  currentCourseSectionId   String                 @map("current_course_section_id")
  preferredTimeBlockId     String?                @map("preferred_time_block_id")
  reason                   String
  status                   RequestStatus          @default(PENDING)
  priority                 RequestPriority        @default(MEDIUM)
  reviewedById             String?                @map("reviewed_by_id")
  resolutionNotes          String?                @map("resolution_notes")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  requestedCourseSectionId String                 @map("requested_course_section_id")
  courseConflicts          CourseConflict[]
  waitlist                 CourseWaitlist[]
  actions                  ScheduleChangeAction[]
  currentCourseSection     CourseSection          @relation("CurrentSection", fields: [currentCourseSectionId], references: [id])
  preferredTimeBlock       TimeBlock?             @relation(fields: [preferredTimeBlockId], references: [id])
  requestedCourseSection   CourseSection          @relation("RequestedSection", fields: [requestedCourseSectionId], references: [id])
  reviewer                 User?                  @relation("RequestReviewer", fields: [reviewedById], references: [id])
  schoolYear               SchoolYear             @relation(fields: [schoolYearId], references: [id])
  student                  Student                @relation(fields: [studentId], references: [id])
  term                     Term                   @relation(fields: [termId], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("schedule_change_request")
}

model ScheduleChangeAction {
  id                     String                @id @default(cuid())
  requestId              String                @map("request_id")
  removedCourseSectionId String?               @map("removed_course_section_id")
  addedCourseSectionId   String?               @map("added_course_section_id")
  actionById             String                @map("action_by_id")
  actionDate             DateTime              @default(now()) @map("action_date")
  notes                  String?
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  actionBy               User                  @relation("ActionPerformer", fields: [actionById], references: [id])
  addedCourseSection     CourseSection?        @relation("AddedSection", fields: [addedCourseSectionId], references: [id])
  removedCourseSection   CourseSection?        @relation("RemovedSection", fields: [removedCourseSectionId], references: [id])
  request                ScheduleChangeRequest @relation(fields: [requestId], references: [id])

  @@map("schedule_change_action")
}

model CourseConflict {
  id               String                 @id @default(cuid())
  courseSectionId1 String                 @map("course_section_id1")
  courseSectionId2 String                 @map("course_section_id2")
  conflictType     ConflictType           @map("conflict_type")
  isResolvable     Boolean                @default(false) @map("is_resolvable")
  resolutionNotes  String?                @map("resolution_notes")
  requestId        String?                @map("request_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  courseSection1   CourseSection          @relation("ConflictSection1", fields: [courseSectionId1], references: [id])
  courseSection2   CourseSection          @relation("ConflictSection2", fields: [courseSectionId2], references: [id])
  request          ScheduleChangeRequest? @relation(fields: [requestId], references: [id])

  @@unique([courseSectionId1, courseSectionId2])
  @@index([courseSectionId1])
  @@index([courseSectionId2])
  @@map("course_conflict")
}

model CourseWaitlist {
  id              String                 @id @default(cuid())
  courseSectionId String                 @map("course_section_id")
  studentId       String                 @map("student_id")
  position        Int
  requestId       String?                @map("request_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  courseSection   CourseSection          @relation(fields: [courseSectionId], references: [id])
  request         ScheduleChangeRequest? @relation(fields: [requestId], references: [id])
  student         Student                @relation(fields: [studentId], references: [id])

  @@unique([courseSectionId, studentId])
  @@index([courseSectionId])
  @@index([studentId])
  @@index([requestId])
  @@map("course_waitlist")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(100)
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model Rule {
  id          String   @id @default(cuid())
  name        String   @unique
  type        RuleType
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("rule")
}

model CourseRule {
  id                  String   @id @default(cuid())
  courseId            String   @map("course_id")
  conflictingCourseId String   @map("conflicting_course_id")
  type                RuleType
  description         String
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  isOverridable       Boolean  @default(false) @map("is_overridable")
  conflictingCourse   Course   @relation("ConflictingCourseRules", fields: [conflictingCourseId], references: [id])
  course              Course   @relation("CourseRules", fields: [courseId], references: [id])

  @@unique([courseId, conflictingCourseId])
  @@index([courseId])
  @@index([conflictingCourseId])
  @@map("course_rule")
}

model GradeLookup {
  id          String   @id @default(cuid())
  grade       String   @unique @db.VarChar(2)
  gradePoints Decimal  @map("grade_points") @db.Decimal(3, 2)
  description String?  @db.VarChar(100)
  isPassing   Boolean  @default(true) @map("is_passing")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("grade_lookup")
}

model VerificationCode {
  id        String               @id @default(cuid())
  email     String               @db.VarChar(255)
  code      String               @db.VarChar(6)
  type      VerificationCodeType
  expiresAt DateTime             @map("expires_at")
  isUsed    Boolean              @default(false) @map("is_used")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([email, type])
  @@index([code])
  @@index([expiresAt])
  @@map("verification_code")
}

model UserAccount {
  id                  String               @id @default(cuid())
  userId              String               @unique @map("user_id")
  isActive            Boolean              @default(true) @map("is_active")
  isLocked            Boolean              @default(false) @map("is_locked")
  lockReason          String?              @map("lock_reason") @db.VarChar(500)
  lastLoginAt         DateTime?            @map("last_login_at")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  passwordChangedAt   DateTime             @default(now()) @map("password_changed_at")
  expiresAt           DateTime?            @map("expires_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHistory      UserAccountHistory[]

  @@map("user_account")
}

model UserAccountHistory {
  id              String      @id @default(cuid())
  userAccountId   String      @map("user_account_id")
  action          String      @db.VarChar(50)
  reason          String?     @db.VarChar(500)
  performedBy     String      @map("performed_by")
  performedAt     DateTime    @default(now()) @map("performed_at")
  performedByUser User        @relation("AccountActionPerformer", fields: [performedBy], references: [id])
  userAccount     UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId])
  @@index([performedAt])
  @@map("user_account_history")
}

