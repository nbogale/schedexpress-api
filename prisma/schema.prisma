model ScheduleChangeRequest {
  id                       String                 @id @default(cuid())
  studentId                String                 @map("student_id")
  academicCycleId          String                 @map("academic_cycle_id")
  requestType              RequestType            @map("request_type")
  currentCourseSectionId   String?                @map("current_course_section_id")
  preferredTimeBlockId     String?                @map("preferred_time_block_id")
  reason                   String
  status                   RequestStatus          @default(PENDING)
  priority                 RequestPriority        @default(MEDIUM)
  reviewedById             String?                @map("reviewed_by_id")
  resolutionNotes          String?                @map("resolution_notes")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
