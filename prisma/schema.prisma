generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                        @id @default(cuid())
  email                   String                        @unique @db.VarChar(255)
  passwordHash            String                        @map("password_hash") @db.VarChar(255)
  firstName               String                        @map("first_name") @db.VarChar(100)
  lastName                String                        @map("last_name") @db.VarChar(100)
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  username                String                        @unique @db.VarChar(50)
  status                  UserStatus                    @default(ACTIVE)
  role                    UserRole
  academicCycleValidators AcademicCycle[]               @relation("AcademicCycleValidator")
  academicCycleConfigs    AcademicCycleConfig[]         @relation("AcademicCycleConfigCreator")
  academicPeriodsCreated  AcademicPeriod[]              @relation("AcademicPeriodCreator")
  academicYearTemplates   AcademicYearTemplate[]        @relation("AcademicYearTemplateCreator")
  auditLogs               AuditLog[]
  notifications           Notification[]
  performedActions        ScheduleChangeAction[]        @relation("ActionPerformer")
  reviewedRequests        ScheduleChangeRequest[]       @relation("RequestReviewer")
  reviewedPreferences     CoursePreference[]            @relation("PreferenceReviewer")
  createdPreferences      CoursePreference[]            @relation("PreferenceCreator")
  student                 Student?
  gradesGiven             StudentGrade[]                @relation("GradeTeacher")
  teacher                 Teacher?
  parentGuardian          ParentGuardian?
  userAccount             UserAccount?
  accountActionsPerformed UserAccountHistory[]          @relation("AccountActionPerformer")
  statusChangesPerformed  UserStatusHistory[]           @relation("StatusChangePerformer")
  statusHistory           UserStatusHistory[]
  scheduleImportFiles     ScheduleImportFile[]          @relation("ScheduleImportUploader")
  submittedGrades         StudentCourseHistory[]        @relation("GradeSubmitter")
  requirementCreator      GraduationRequirement[]       @relation("RequirementCreator")
  auditPerformer          GraduationAudit[]             @relation("AuditPerformer")
  auditWaiver             GraduationAudit[]             @relation("AuditWaiver")
  allocationCreator       CourseRequirementAllocation[] @relation("AllocationCreator")
  conflictResolver        CourseRequirementAllocation[] @relation("ConflictResolver")
  auditNoteCreator        AuditNote[]                   @relation("AuditNoteCreator")
  auditNoteCompleter      AuditNote[]                   @relation("AuditNoteCompleter")
  planSubmitter           GraduationPlan[]              @relation("PlanSubmitter")
  planApprover            GraduationPlan[]              @relation("PlanApprover")
  planRejector            GraduationPlan[]              @relation("PlanRejector")
  planHistoryPerformer    GraduationPlanHistory[]       @relation("PlanHistoryPerformer")
  planNoteCreator         PlanNote[]                    @relation("PlanNoteCreator")
  planNoteCompleter       PlanNote[]                    @relation("PlanNoteCompleter")

  @@map("user")
}

model UserStatusHistory {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  status        UserStatus
  reason        String?    @db.VarChar(500)
  changedBy     String     @map("changed_by")
  changedAt     DateTime   @default(now()) @map("changed_at")
  changedByUser User       @relation("StatusChangePerformer", fields: [changedBy], references: [id])
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedAt])
  @@map("user_status_history")
}

model Student {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  studentId         String   @unique @map("student_id") @db.VarChar(20)
  gradeLevelId      String   @map("grade_level_id")
  graduationYear    Int?     @map("graduation_year")
  hasIep            Boolean  @default(false) @map("has_iep")
  isDualEnrollment  Boolean  @default(false) @map("is_dual_enrollment")
  isCollegeBound    Boolean  @default(false) @map("is_college_bound")
  isCreditRecovery  Boolean  @default(false) @map("is_credit_recovery")
  maxCreditsPerTerm Decimal  @default(8.0) @map("max_credits_per_term") @db.Decimal(3, 1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Parent/Guardian References (Direct)
  primaryParentId    String? @map("primary_parent_id")
  secondaryParentId  String? @map("secondary_parent_id")
  emergencyContactId String? @map("emergency_contact_id")

  // Existing relationships
  waitlist              CourseWaitlist[]
  notifications         Notification[]
  schedules             Schedule[]
  changeRequests        ScheduleChangeRequest[]
  coursePreferences     CoursePreference[]
  gradeLevel            GradeLevel                    @relation(fields: [gradeLevelId], references: [id])
  user                  User                          @relation(fields: [userId], references: [id])
  courseHistory         StudentCourseHistory[]
  grades                StudentGrade[]
  graduationAudits      GraduationAudit[]
  courseAllocations     CourseRequirementAllocation[]
  graduationPlans       GraduationPlan[]
  courseRecommendations CourseRecommendation[]

  // Parent relationships
  primaryParent    ParentGuardian? @relation("PrimaryParent", fields: [primaryParentId], references: [id])
  secondaryParent  ParentGuardian? @relation("SecondaryParent", fields: [secondaryParentId], references: [id])
  emergencyContact ParentGuardian? @relation("EmergencyContact", fields: [emergencyContactId], references: [id])

  @@map("student")
}

model StudentCourseHistory {
  id              String  @id @default(cuid())
  studentId       String  @map("student_id")
  courseId        String  @map("course_id")
  academicCycleId String  @map("academic_cycle_id")
  grade           String? @db.VarChar(2)
  isPassed        Boolean @default(true) @map("is_passed")
  creditEarned    Decimal @map("credit_earned") @db.Decimal(3, 1)

  // New fields for multiple submissions
  gradeType         GradeType @default(INTERIM) @map("grade_type")
  isFinal           Boolean   @default(false) @map("is_final")
  submissionDate    DateTime  @default(now()) @map("submission_date")
  submittedBy       String?   @map("submitted_by")
  notes             String?   @db.Text
  calculatedFrom    String?   @map("calculated_from") // JSON array of grade IDs
  calculationMethod String?   @map("calculation_method") @db.VarChar(50) // e.g., AVERAGE, LATEST, MANUAL

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course               Course                        @relation(fields: [courseId], references: [id])
  academicCycle        AcademicCycle                 @relation(fields: [academicCycleId], references: [id])
  student              Student                       @relation(fields: [studentId], references: [id])
  submittedByUser      User?                         @relation("GradeSubmitter", fields: [submittedBy], references: [id])
  courseAllocations    CourseRequirementAllocation[]
  completedPlanCourses GraduationPlanCourse[]

  @@index([academicCycleId])
  @@index([studentId, courseId, academicCycleId, gradeType]) // New composite index
  @@index([submittedBy]) // New index
  @@map("student_course_history")
}

model StudentGrade {
  id              String        @id @default(cuid())
  studentId       String        @map("student_id")
  courseId        String        @map("course_id")
  academicCycleId String        @map("academic_cycle_id")
  grade           String?       @db.VarChar(2)
  gradePoints     Decimal?      @map("grade_points") @db.Decimal(3, 2)
  percentage      Decimal?      @db.Decimal(5, 2)
  isPassed        Boolean       @default(true) @map("is_passed")
  creditEarned    Decimal       @map("credit_earned") @db.Decimal(3, 1)
  gradedBy        String?       @map("graded_by")
  gradedAt        DateTime?     @map("graded_at")
  notes           String?
  academicCycle   AcademicCycle @relation(fields: [academicCycleId], references: [id])
  course          Course        @relation(fields: [courseId], references: [id])
  teacher         User?         @relation("GradeTeacher", fields: [gradedBy], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId, academicCycleId])
  @@map("student_grade")
}

model CourseSection {
  id                        String                  @id @default(cuid())
  courseId                  String                  @map("course_id")
  sectionNumber             String                  @map("section_number") @db.VarChar(10)
  timeBlockId               String                  @map("time_block_id")
  endTimeBlockId            String?                 @map("end_time_block_id")
  roomId                    String                  @map("room_id")
  teacherId                 String                  @map("teacher_id")
  maxEnrollment             Int                     @map("max_enrollment")
  currentEnrollment         Int                     @default(0) @map("current_enrollment")
  isActive                  Boolean                 @default(true) @map("is_active")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  rotationDay               RotationDay?            @map("rotation_day")
  academicCycleId           String                  @map("academic_cycle_id")
  conflicts1                CourseConflict[]        @relation("ConflictSection1")
  conflicts2                CourseConflict[]        @relation("ConflictSection2")
  academicCycle             AcademicCycle           @relation(fields: [academicCycleId], references: [id])
  course                    Course                  @relation(fields: [courseId], references: [id])
  room                      Room                    @relation(fields: [roomId], references: [id])
  teacher                   Teacher                 @relation(fields: [teacherId], references: [id])
  timeBlock                 TimeBlock               @relation("StartTimeBlock", fields: [timeBlockId], references: [id])
  endTimeBlock              TimeBlock?              @relation("EndTimeBlock", fields: [endTimeBlockId], references: [id])
  waitlist                  CourseWaitlist[]
  addedInActions            ScheduleChangeAction[]  @relation("AddedSection")
  removedInActions          ScheduleChangeAction[]  @relation("RemovedSection")
  currentChangeRequests     ScheduleChangeRequest[] @relation("CurrentSection")
  requestedInChangeRequests ScheduleChangeRequest[] @relation("RequestedSection")
  scheduleCourseSections    ScheduleCourseSection[]
  importDetails             ScheduleImportDetail[]

  @@index([courseId])
  @@index([academicCycleId])
  @@index([teacherId])
  @@index([endTimeBlockId])
  @@map("course_section")
}

model Schedule {
  id                     String                  @id @default(cuid())
  studentId              String                  @map("student_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  academicCycleId        String                  @map("academic_cycle_id")
  student                Student                 @relation(fields: [studentId], references: [id])
  academicCycle          AcademicCycle           @relation(fields: [academicCycleId], references: [id])
  scheduleCourseSections ScheduleCourseSection[]
  importDetails          ScheduleImportDetail[]

  @@unique([studentId, academicCycleId])
  @@index([academicCycleId])
  @@index([studentId])
  @@map("schedule")
}

model ScheduleCourseSection {
  id              String        @id @default(cuid())
  scheduleId      String        @map("schedule_id")
  courseSectionId String        @map("course_section_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  courseSection   CourseSection @relation(fields: [courseSectionId], references: [id], onDelete: Cascade)
  schedule        Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, courseSectionId])
  @@index([scheduleId])
  @@index([courseSectionId])
  @@map("schedule_course_section")
}

model Notification {
  id               String           @id @default(cuid())
  studentId        String?          @map("student_id")
  userId           String?          @map("user_id")
  parentGuardianId String?          @map("parent_guardian_id")
  message          String
  read             Boolean          @default(false)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  type             NotificationType
  student          Student?         @relation(fields: [studentId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])
  parentGuardian   ParentGuardian?  @relation(fields: [parentGuardianId], references: [id])

  @@map("notification")
}

model ParentGuardian {
  id                      String                   @id @default(cuid())
  userId                  String?                  @unique @map("user_id")
  firstName               String                   @map("first_name") @db.VarChar(100)
  lastName                String                   @map("last_name") @db.VarChar(100)
  email                   String?                  @unique @db.VarChar(255)
  primaryPhone            String?                  @map("primary_phone") @db.VarChar(20)
  secondaryPhone          String?                  @map("secondary_phone") @db.VarChar(20)
  relationship            RelationshipType
  isPrimaryContact        Boolean                  @default(false) @map("is_primary_contact")
  isEmergencyContact      Boolean                  @default(false) @map("is_emergency_contact")
  preferredContactMethod  ContactMethod            @default(EMAIL) @map("preferred_contact_method")
  notificationPreferences NotificationPreferences?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  // User relationship
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Direct relationships
  notifications Notification[]

  // Reverse relationships to students
  primaryStudents   Student[]        @relation("PrimaryParent")
  secondaryStudents Student[]        @relation("SecondaryParent")
  emergencyStudents Student[]        @relation("EmergencyContact")
  approvedPlans     GraduationPlan[]

  @@map("parent_guardian")
}

model NotificationPreferences {
  id               String @id @default(cuid())
  parentGuardianId String @unique @map("parent_guardian_id")

  // Notification Types
  scheduleChanges      Boolean @default(true) @map("schedule_changes")
  gradeUpdates         Boolean @default(true) @map("grade_updates")
  attendanceAlerts     Boolean @default(true) @map("attendance_alerts")
  counselorMeetings    Boolean @default(true) @map("counselor_meetings")
  emergencyAlerts      Boolean @default(true) @map("emergency_alerts")
  generalAnnouncements Boolean @default(false) @map("general_announcements")

  // Delivery Preferences
  emailEnabled     Boolean @default(true) @map("email_enabled")
  smsEnabled       Boolean @default(false) @map("sms_enabled")
  phoneCallEnabled Boolean @default(false) @map("phone_call_enabled")

  // Frequency
  digestFrequency DigestFrequency @default(DAILY) @map("digest_frequency")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  parentGuardian ParentGuardian @relation(fields: [parentGuardianId], references: [id])

  @@map("notification_preferences")
}

model Settings {
  id             String  @id @default(cuid())
  schoolName     String  @map("school_name")
  maxCourseLoad  Int     @default(8) @map("max_course_load")
  allowConflicts Boolean @default(false) @map("allow_conflicts")

  // Schedule Configuration
  scheduleType    ScheduleType @default(STANDARD) @map("schedule_type")
  hasRotationDays Boolean      @default(false) @map("has_rotation_days")
  rotationPattern String?      @map("rotation_pattern") @db.VarChar(255)

  // Time Block Rules
  minBlockDuration       Int     @default(45) @map("min_block_duration") // in minutes
  maxBlockDuration       Int     @default(120) @map("max_block_duration") // in minutes
  allowOverlappingBlocks Boolean @default(false) @map("allow_overlapping_blocks")

  // Schedule Change Request Configuration (Global Defaults)
  scheduleChangeConfig Json? @map("schedule_change_config")

  // Relations
  academicSettings AcademicSettings?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AcademicSettings {
  id         String @id @default(cuid())
  settingsId String @unique @map("settings_id")

  // Academic Structure Configuration
  academicStructureType  String  @default("SCHOOL_YEAR_ONLY") @map("academic_structure_type") @db.VarChar(50)
  enableAcademicDefaults Boolean @default(true) @map("enable_academic_defaults")
  defaultSemesterCount   Int     @default(0) @map("default_semester_count")
  defaultQuarterCount    Int     @default(0) @map("default_quarter_count")
  defaultTrimesterCount  Int     @default(0) @map("default_trimester_count")
  semestersHaveQuarters  Boolean @default(false) @map("semesters_have_quarters")

  // Academic Period Defaults Configuration (JSON for flexibility)
  defaultPeriodConfiguration Json? @map("default_period_configuration")

  // Academic Period Business Rules (JSON)
  academicPeriodRules Json? @map("academic_period_rules")

  // Relations
  settings Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("academic_settings")
}

model AcademicCycleConfig {
  id                String              @id @default(cuid())
  name              String              @db.VarChar(100)
  description       String?
  isActive          Boolean             @default(false) @map("is_active")
  isDefault         Boolean             @default(false) @map("is_default")
  hasSemesters      Boolean             @default(true) @map("has_semesters")
  hasQuarters       Boolean             @default(true) @map("has_quarters")
  hasTrimesters     Boolean             @default(false) @map("has_trimesters")
  hasSessions       Boolean             @default(false) @map("has_sessions")
  enforceStructure  Boolean             @default(true) @map("enforce_structure")
  allowCustomCycles Boolean             @default(false) @map("allow_custom_cycles")
  requireValidation Boolean             @default(true) @map("require_validation")
  createdBy         String              @map("created_by")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  academicCycles    AcademicCycle[]
  creator           User                @relation("AcademicCycleConfigCreator", fields: [createdBy], references: [id])
  cycleRules        AcademicCycleRule[]

  @@map("academic_cycle_config")
}

model AcademicCycleRule {
  id               String              @id @default(cuid())
  configId         String              @map("config_id")
  parentCycleType  CycleType?          @map("parent_cycle_type")
  cycleType        CycleType           @map("cycle_type")
  cycleName        String              @db.VarChar(100)
  cycleNumber      Int?                @map("cycle_number")
  isRequired       Boolean             @default(true) @map("is_required")
  minCount         Int                 @default(1) @map("min_count")
  maxCount         Int                 @default(1) @map("max_count")
  defaultDuration  Int                 @default(90) @map("default_duration")
  sortOrder        Int                 @default(0) @map("sort_order")
  mustBeSequential Boolean             @default(true) @map("must_be_sequential")
  mustHaveGaps     Boolean             @default(false) @map("must_have_gaps")
  allowOverlap     Boolean             @default(false) @map("allow_overlap")
  config           AcademicCycleConfig @relation(fields: [configId], references: [id])

  @@unique([configId, cycleType, cycleNumber])
  @@map("academic_cycle_rule")
}

model AcademicCycle {
  id          String    @id @default(cuid())
  parentId    String?   @map("parent_id")
  configId    String?   @map("config_id")
  name        String    @db.VarChar(100)
  cycleType   CycleType @map("cycle_type")
  cycleNumber Int?      @map("cycle_number")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date

  // Opening/Closing dates (for school year)
  openingDate DateTime? @map("opening_date") @db.Date
  closingDate DateTime? @map("closing_date") @db.Date

  isCurrent       Boolean   @default(false) @map("is_current")
  isActive        Boolean   @default(true) @map("is_active")
  isValidated     Boolean   @default(false) @map("is_validated")
  validatedBy     String?   @map("validated_by")
  validatedAt     DateTime? @map("validated_at")
  validationNotes String?   @map("validation_notes")
  description     String?

  // Schedule Change Request Configuration (Cycle-Specific Overrides)
  scheduleChangeConfig Json? @map("schedule_change_config")

  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  config                 AcademicCycleConfig?    @relation(fields: [configId], references: [id])
  parent                 AcademicCycle?          @relation("CycleHierarchy", fields: [parentId], references: [id])
  children               AcademicCycle[]         @relation("CycleHierarchy")
  validator              User?                   @relation("AcademicCycleValidator", fields: [validatedBy], references: [id])
  periods                AcademicPeriod[]
  courseSections         CourseSection[]
  grades                 StudentGrade[]
  scheduleChangeRequests ScheduleChangeRequest[]
  schedules              Schedule[]
  studentCourseHistory   StudentCourseHistory[]
  scheduleImportFiles    ScheduleImportFile[]
  coursePreferences      CoursePreference[]
  graduationAudits       GraduationAudit[]
  plannedCourses         GraduationPlanCourse[]
  courseRecommendations  CourseRecommendation[]

  @@index([parentId])
  @@index([cycleType])
  @@index([configId])
  @@index([openingDate, closingDate])
  @@map("academic_cycle")
}

model AcademicPeriod {
  id          String               @id @default(cuid())
  cycleId     String               @map("cycle_id")
  name        String               @db.VarChar(100)
  periodType  AcademicPeriodType   @map("period_type")
  status      AcademicPeriodStatus @default(PLANNED)
  startDate   DateTime             @map("start_date") @db.Date
  endDate     DateTime             @map("end_date") @db.Date
  description String?

  // Configuration
  isInstructional       Boolean @default(false) @map("is_instructional")
  allowsEnrollment      Boolean @default(false) @map("allows_enrollment")
  allowsGrading         Boolean @default(false) @map("allows_grading")
  allowsScheduleChanges Boolean @default(false) @map("allows_schedule_changes")
  isBreak               Boolean @default(false) @map("is_break")

  // Metadata
  sortOrder Int      @default(0) @map("sort_order")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  cycle   AcademicCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  creator User          @relation("AcademicPeriodCreator", fields: [createdBy], references: [id])

  @@index([cycleId])
  @@index([periodType])
  @@index([startDate, endDate])
  @@map("academic_period")
}

model AcademicYearTemplate {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(100)
  description String?
  schoolLevel String  @map("school_level") @db.VarChar(50)

  // Structure
  hasSemesters  Boolean @default(true) @map("has_semesters")
  hasQuarters   Boolean @default(true) @map("has_quarters")
  hasTrimesters Boolean @default(false) @map("has_trimesters")

  // Default periods configuration (JSON for flexibility)
  defaultPeriods Json? @map("default_periods")

  isActive  Boolean @default(false) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator           User                       @relation("AcademicYearTemplateCreator", fields: [createdBy], references: [id])
  periodDefinitions TemplatePeriodDefinition[]

  @@map("academic_year_template")
}

model TemplatePeriodDefinition {
  id         String             @id @default(cuid())
  templateId String             @map("template_id")
  cycleType  CycleType          @map("cycle_type")
  periodType AcademicPeriodType @map("period_type")

  // Timing configuration (relative to cycle start/end)
  timingType  String @map("timing_type") @db.VarChar(50)
  timingValue Int    @map("timing_value")
  duration    Int

  // Configuration flags
  isInstructional       Boolean @default(false) @map("is_instructional")
  allowsEnrollment      Boolean @default(false) @map("allows_enrollment")
  allowsGrading         Boolean @default(false) @map("allows_grading")
  allowsScheduleChanges Boolean @default(false) @map("allows_schedule_changes")
  isBreak               Boolean @default(false) @map("is_break")

  sortOrder Int     @default(0) @map("sort_order")
  name      String? @db.VarChar(100)

  template AcademicYearTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_period_definition")
}

model Department {
  id          String           @id @default(cuid())
  name        String           @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  code        String           @db.VarChar(10)
  description String?
  courses     Course[]
  sequences   CourseSequence[]
  teachers    Teacher[]

  @@map("department")
}

model CourseLevel {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  rank      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  courses   Course[]

  @@map("course_level")
}

model GradeLevel {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(50)
  level     Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  courses   Course[]  @relation("MinGradeLevel")
  students  Student[]

  @@map("grade_level")
}

model Course {
  id                    String                  @id @default(cuid())
  code                  String                  @unique @db.VarChar(20)
  name                  String                  @db.VarChar(255)
  description           String?
  departmentId          String                  @map("department_id")
  credits               Decimal                 @default(1.0) @db.Decimal(3, 1)
  courseLevelId         String                  @map("course_level_id")
  minGradeLevelId       String                  @map("min_grade_level_id")
  maxStudents           Int                     @default(30) @map("max_students")
  isElective            Boolean                 @default(false) @map("is_elective")
  isCore                Boolean                 @default(false) @map("is_core")
