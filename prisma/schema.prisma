model CoursePreference {
  id              String                 @id @default(cuid())
  studentId       String                 @map("student_id")
  courseId        String                 @map("course_id")
  academicCycleId String                 @map("academic_cycle_id")
  reason          String?
  priority        Int? // 1st choice, 2nd choice, 3rd choice, etc.
  status          CoursePreferenceStatus @default(DRAFT)
  counselorNotes  String?                @map("counselor_notes") @db.Text
  submittedAt     DateTime?              @map("submitted_at")
  reviewedAt      DateTime?              @map("reviewed_at")
  reviewedById    String?                @map("reviewed_by_id")
  createdBy       String?                @map("created_by") // userId who created (null = student)
  source          PreferenceSource       @default(STUDENT_INITIATED)
  autoApproved    Boolean                @default(false) @map("auto_approved")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicCycle AcademicCycle @relation(fields: [academicCycleId], references: [id], onDelete: Cascade)
  reviewer      User?         @relation("PreferenceReviewer", fields: [reviewedById], references: [id])
  creator       User?         @relation("PreferenceCreator", fields: [createdBy], references: [id])

  @@unique([studentId, courseId, academicCycleId])
  @@unique([studentId, academicCycleId, priority]) // Ensure unique priority per student per academic cycle
  @@index([studentId])
  @@index([academicCycleId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([createdBy])
  @@map("course_preference")
}

